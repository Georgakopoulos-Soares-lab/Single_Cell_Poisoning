
# cloned upstream repos, studied not tracked
learning/prodva_poisoning_learn/repo/
learning/scimilarity_learn/scimilarity/

# ── 0_data: deny by default, allow provenance only ──────────────────────────
# Inputs are large (the model tarball alone is 28.2 GB, plus TileDB fragments
# and 92 GB of .h5ad). None of it is tracked. What IS tracked is everything
# needed to re-acquire it byte-for-byte: checksums, the fetch transcript, and
# the manifest naming all 46 CELLxGENE datasets with their source URLs.
# cl.obo is deliberately excluded too -- 17 MB, publicly versioned, and pinned
# by its md5 and data-version line in CHECKSUMS.txt, same treatment as the model.
0_data/**
!0_data/CHECKSUMS.txt
!0_data/download.log
!0_data/queries/
!0_data/queries/INVENTORY.tsv
!0_data/queries/COMPOSITION.tsv
!0_data/queries/cellxgene/
!0_data/queries/cellxgene/MANIFEST.tsv

# derived intermediates, re-derivable from 0_data + 1_scripts
cache/

# ── per-cell raw tables: regenerable, too large to track ─────────────────────
# One row per query cell per condition: 12,874 files, 9.8 GB. Excluded, as the
# previous run's raw tables were (see docs/RUNLOG.md). Everything downstream --
# the summary and sweep tables beside it -- IS committed, so results are
# auditable; only the per-cell detail must be regenerated by rerunning the
# sweep stage from cache/. The scripts that produce it are all tracked.
# Depth-independent: the tree moved under v01/ and v02/, and an anchored
# pattern silently stopped matching -- 9.8 GB was staged before this was
# caught. Match at any depth so a future move cannot break it again.
**/00_raw/raw/
